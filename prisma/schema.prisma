generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  avatarUrl   String?
  preferences Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks         Task[]
  projects      Project[]
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
  opportunities Opportunity[]
  notes         Note[]
  decks         Deck[]
  questions     Question[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#888")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  priority    Priority   @default(P1)
  status      TaskStatus @default(Todo)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt       DateTime?
  aiSuggested Boolean    @default(false)
  done        Boolean    @default(false)
  parentId    String?
  parent      Task?      @relation("subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]     @relation("subtasks")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  role      String
  stage     JobStage @default(Wishlist)
  salary    String?
  location  String?
  url       String?
  notes     String?
  match     Int      @default(0)
  nextStep  String?
  appliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Opportunity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String
  title     String
  desc      String?
  tags      String[] @default([])
  reward    String?
  entries   Int      @default(0)
  score     Int      @default(0)
  state     String   @default("New")
  dueAt     DateTime?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  category   String   @default("System Design")
  difficulty String   @default("Medium")
  state      String   @default("unseen")
  company    String?
  hint       String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  tags      String[] @default([])
  links     String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deck {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  tag       String   @default("General")
  color     String   @default("#6366f1")
  cards     Card[]
  createdAt DateTime @default(now())
}

model Card {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String
  back      String
  interval  Int      @default(1)
  ease      Float    @default(2.5)
  reps      Int      @default(0)
  dueAt     DateTime @default(now())
  createdAt DateTime @default(now())
}

enum Priority {
  P0
  P1
  P2
}

enum TaskStatus {
  Todo
  InProgress
  Blocked
  Completed
}

enum JobStage {
  Wishlist
  Applied
  OA
  Interview
  Offer
  Rejected
}
